# vim: set ft=bash ts=4 sw=4 sts=4 noet ai eol:
# shellcheck disable=SC2086

# =====================
#  Reset, Clear, Home
# =====================
_rst=$'\e[0m'			# Reset to normal attributes
_cls=$'\e[H\e[J'		# Home & clear to end of screen
_hom=$'\e[0;0H'			# Cursor to Home R0C0
_el=$'\e[2K'			# Erase Line
_scp=$'\e[s'			# Save cursor pos
_rcp=$'\e[u'			# Restore cursor pos
_coff=$'\e[?25l'		# Hide cursor
_con=$'\e[?25h'			# Show cursor
_alton=$'\e[?1049h'		# Alternate screen buffer
_altoff=$'\e[?1049l'	# Exit alternate screen buffer

# =====================
#      Attributes
# =====================
_d=$'\e[1m'		# Bold
_i=$'\e[2m'		# Dim
_l=$'\e[3m'		# Italic
_u=$'\e[4m'		# Underscore
_f=$'\e[5m'		# Blink (flash)
_v=$'\e[7m'		# Reverse
_s=$'\e[9m'		# Strike out

# =====================
#   Foreground Colors
# =====================
_k=$'\e[30m'	# Black
_r=$'\e[31m'	# Red
_g=$'\e[32m'	# Green
_y=$'\e[33m'	# Yellow
_b=$'\e[34m'	# Blue
_m=$'\e[35m'	# Magenta
_c=$'\e[36m'	# Cyan
_w=$'\e[37m'	# White

_dk=$'\e[1;30m'		# Bold Black
_dr=$'\e[1;31m'		# Bold Red
_dg=$'\e[1;32m'		# Bold Green
_dy=$'\e[1;33m'		# Bold Yellow
_db=$'\e[1;34m'		# Bold Blue
_dm=$'\e[1;35m'		# Bold Magenta
_dc=$'\e[1;36m'		# Bold Cyan
_dw=$'\e[1;37m'		# Bold White

# =====================
#   Background Colors
# =====================
_K=$'\e[40m'	# Black
_R=$'\e[41m'	# Red
_G=$'\e[42m'	# Green
_Y=$'\e[43m'	# Yellow
_B=$'\e[44m'	# Blue
_M=$'\e[45m'	# Magenta
_C=$'\e[46m'	# Cyan
_W=$'\e[47m'	# White

_dK=$'\e[1;40m'		# Bold Black
_dR=$'\e[1;41m'		# Bold Red
_dG=$'\e[1;42m'		# Bold Green
_dY=$'\e[1;43m'		# Bold Yellow
_dB=$'\e[1;44m'		# Bold Blue
_dM=$'\e[1;45m'		# Bold Magenta
_dC=$'\e[1;46m'		# Bold Cyan
_dW=$'\e[1;47m'		# Bold White

# =====================
#  Common Combinations
# =====================

_vdkW=$'\e[1;7;37;40m'	# Reverse Bold Black on White
_vdrW=$'\e[1;7;37;41m'	# Reverse Bold Red on White
_vdbW=$'\e[1;7;37;44m'	# Reverse Bold Blue on White
_vdmW=$'\e[1;7;37;45m'	# Reverse Bold Magenta on White
_dwR=$'\e[1;41;37m'		# Bold White on Red
_dwB=$'\e[1;44;37m'		# Bold White on Blue
_dur=$'\e[1;4;31m'		# Bold Underline Red
_dug=$'\e[1;4;32m'		# Bold Underline Green
_duy=$'\e[1;4;33m'		# Bold Underline Yellow
_dub=$'\e[1;4;34m'		# Bold Underline Blue
_dum=$'\e[1;4;35m'		# Bold Underline Magenta
_duc=$'\e[1;4;36m'		# Bold Underline Cyan
_duw=$'\e[1;4;37m'		# Bold Underline White

_err=${_dwR}			# Errors
_wrn=$'\e[30;43m'		# Warnings

# =====================
#   256 color Colors
# =====================

if [[ "$1" == "256" ]]; then
	for n in {16..255}; do
		printf -v _fg256[${n}] "\e[38;5;%dm" "${n}"
		printf -v _bg256[${n}] "\e[48;5;%dm" "${n}"
		printf -v _fg256d[${n}] "\e[1;38;5;%dm" "${n}"
		printf -v _bg256d[${n}] "\e[1;48;5;%dm" "${n}"
		printf -v _fg256v[${n}] "\e[7;38;5;%dm" "${n}"
		printf -v _bg256v[${n}] "\e[7;48;5;%dm" "${n}"
		printf -v _fg256dv[${n}] "\e[1;7;38;5;%dm" "${n}"
		printf -v _bg256dv[${n}] "\e[1;7;48;5;%dm" "${n}"
	done
fi

# =====================
#       Functions
# =====================
function _pos()
{
	local row=$1
	local col=$2
	printf "\e[%d;%dH" "$row" "$col"
}

function _cup()
{
	local n=${1:-1}
	printf "\e[%dA" "$n"
}

function _cdown()
{
	local n=${1:-1}
	printf "\e[%dB" "$n"
}

function _cright()
{
	local n=${1:-1}
	printf "\e[%dC" "$n"
}

function _cleft()
{
	local n=${1:-1}
	printf "\e[%dD" "$n"
}

function _fg_rgb()
{
	local r=$1
	local g=$2
	local b=$3
	printf "\e[38;2;%d;%d;%dm" "$r" "$g" "$b"
}

function _bg_rgb()
{
	local r=$1
	local g=$2
	local b=$3
	printf "\e[48;2;%d;%d;%dm" "$r" "$g" "$b"
}

function _fg_rgbd()
{
	local r=$1
	local g=$2
	local b=$3
	printf "\e[1;38;2;%d;%d;%dm" "$r" "$g" "$b"
}

function _bg_rgbd()
{
	local r=$1
	local g=$2
	local b=$3
	printf "\e[1;48;2;%d;%d;%dm" "$r" "$g" "$b"
}
