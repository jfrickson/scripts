# vim: set ft=bash ts=4 sw=4 sts=4 noet ai eol:
# shellcheck disable=SC2086

# =====================
#  Reset, Clear, Home
# =====================
printf -v _rst '\e[0m'			# Reset to normal attributes
printf -v _cls '\e[H\e[J'       # Home & clear to end of screen
printf -v _hom '\e[0;0H'		# Cursor to Home R0C0
printf -v _el '\e[2K'			# Erase Line
printf -v _scp '\e[s'			# Save cursor pos
printf -v _rcp '\e[u'			# Restore cursor pos

# =====================
#      Attributes
# =====================
printf -v _d '\e[1m'			# Bold
printf -v _i '\e[2m'			# Dim
printf -v _l '\e[3m'			# Italic
printf -v _u '\e[4m'			# Underscore
printf -v _f '\e[5m'			# Blink (flash)
printf -v _v '\e[7m'			# Reverse
printf -v _s '\e[9m'			# Strike out

# =====================
#   Foreground Colors
# =====================
printf -v _k '\e[30m'			# Black
printf -v _r '\e[31m'			# Red
printf -v _g '\e[32m'			# Green
printf -v _y '\e[33m'			# Yellow
printf -v _b '\e[34m'			# Blue
printf -v _m '\e[35m'			# Magenta
printf -v _c '\e[36m'			# Cyan
printf -v _w '\e[37m'			# White

printf -v _dk '\e[1;30m'		# Bold Black
printf -v _dr '\e[1;31m'		# Bold Red
printf -v _dg '\e[1;32m'		# Bold Green
printf -v _dy '\e[1;33m'		# Bold Yellow
printf -v _db '\e[1;34m'		# Bold Blue
printf -v _dm '\e[1;35m'		# Bold Magenta
printf -v _dc '\e[1;36m'		# Bold Cyan
printf -v _dw '\e[1;37m'		# Bold White

# =====================
#   Background Colors
# =====================
printf -v _K '\e[40m'			# Black
printf -v _R '\e[41m'			# Red
printf -v _G '\e[42m'			# Green
printf -v _Y '\e[43m'			# Yellow
printf -v _B '\e[44m'			# Blue
printf -v _M '\e[45m'			# Magenta
printf -v _C '\e[46m'			# Cyan
printf -v _W '\e[47m'			# White

printf -v _dK '\e[1;40m'		# Bold Black
printf -v _dR '\e[1;41m'		# Bold Red
printf -v _dG '\e[1;42m'		# Bold Green
printf -v _dY '\e[1;43m'		# Bold Yellow
printf -v _dB '\e[1;44m'		# Bold Blue
printf -v _dM '\e[1;45m'		# Bold Magenta
printf -v _dC '\e[1;46m'		# Bold Cyan
printf -v _dW '\e[1;47m'		# Bold White

# =====================
#  Common Combinations
# =====================

printf -v _vdkW '\e[1;7;37;40m'		# Reverse Bold Black on White
printf -v _vdrW '\e[1;7;37;41m'		# Reverse Bold Red on White
printf -v _vdbW '\e[1;7;37;44m'		# Reverse Bold Blue on White
printf -v _vdmW '\e[1;7;37;48m'		# Reverse Bold Magenta on White
printf -v _dwR '\e[1;41;37m'		# Bold White on Red
printf -v _dwB '\e[1;44;37m'		# Bold White on Blue
printf -v _dur '\e[1;4;31m'			# Bold Underline Red
printf -v _dug '\e[1;4;32m'			# Bold Underline Green
printf -v _duy '\e[1;4;33m'			# Bold Underline Yellow
printf -v _dub '\e[1;4;34m'			# Bold Underline Blue
printf -v _dum '\e[1;4;35m'			# Bold Underline Magenta
printf -v _duc '\e[1;4;36m'			# Bold Underline Cyan
printf -v _duw '\e[1;4;37m'			# Bold Underline White

_err=${_dwR}						# Errors
printf -v _wrn '\e[30;43m'			# Warnings

# =====================
#   256 color Colors
# =====================

if [[ "$1" == "256" ]]; then
	for n in {16..255}; do
		printf -v _fg256[${n}] "\e[38;5;%dm" "${n}"
		printf -v _bg256[${n}] "\e[48;5;%dm" "${n}"
		printf -v _fg256d[${n}] "\e[1;38;5;%dm" "${n}"
		printf -v _bg256d[${n}] "\e[1;48;5;%dm" "${n}"
		printf -v _fg256v[${n}] "\e[7;38;5;%dm" "${n}"
		printf -v _bg256v[${n}] "\e[7;48;5;%dm" "${n}"
		printf -v _fg256dv[${n}] "\e[1;7;38;5;%dm" "${n}"
		printf -v _bg256dv[${n}] "\e[1;7;48;5;%dm" "${n}"
	done
fi
