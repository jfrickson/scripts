#======================================================================
# Function: read_key_raw
#
# Description:
#	Reads a single key from the keyboard. Handles function keys,
#	cursor keys, etc.
#
# Parameters:
#	variable	Required - variable name to assign the value to
#	parms		Optional, defaults to "-r -n1 -d ''"
#
# Returns:
#	The key or key sequence in the specified variable.
#	If a timeout was specified and expires, the return is '#TIMEOUT'.
#	Some special keys are returned as custom literals. For example:
#		#BS, #ESC, #LF, #TAB, #F1, #UP, #PUP, #HOM
#	Control keys are returned as #C-X
#
# Usage:
#	* Put at the top of your script:
#		bash-------------------------------------+
#       | PATH="${HOME}/.local/lib/bash:${PATH}" |
#       | . ReadKeyRaw                           |
#		+----------------------------------------+
#	* Somewhere in your script:
#		bash-------------------------------------+
#       | read_key_raw resp "-r -d '' -n1 -t1"   |
#       | echo "You pressed ${resp}"             |
#		+----------------------------------------+
#
#
#======================================================================
function read_key_raw()
{
	if [[ -z "$1" ]]; then
		REPLY="#ERROR"
		return
	fi

	local -n rkr_out=$1
	local parms="${2:--r -n1 -d ''}" rkr_restore rkr_next rkr_ctrl rkr_tmp
	local rkr_first rkr_expected rkr_i
	local rkr_prev_return rkr_prev_int rkr_prev_term

    if [[ -z "$READ_KEY_RAW_BASELINE_STTY" && -t 0 ]]; then
        READ_KEY_RAW_BASELINE_STTY=$(stty -g)
    fi
    rkr_restore="$READ_KEY_RAW_BASELINE_STTY"

	# Set traps
	rkr_prev_return=$(trap -p RETURN)
	rkr_prev_int=$(trap -p INT)
	rkr_prev_term=$(trap -p TERM)

	# Helper function to safely unwind traps and restore terminal
	_rk_cleanup() {
		[[ -n "$rkr_restore" ]] && stty "$rkr_restore"

		# Restore original signal traps
		if [[ -n "$rkr_prev_return" ]]; then eval "$rkr_prev_return"; else trap - RETURN; fi
		if [[ -n "$rkr_prev_int" ]];    then eval "$rkr_prev_int";    else trap - INT;    fi
		if [[ -n "$rkr_prev_term" ]];   then eval "$rkr_prev_term";   else trap - TERM;   fi
	}

	trap '_rk_cleanup; kill -s INT $$' INT
	trap '_rk_cleanup; kill -s TERM $$' TERM
	trap '_rk_cleanup' RETURN

	# Put terminal in raw mode: no echo, no canonical processing
	stty -echo -icanon time 0 min 1
	if ! read ${parms}; then
		rkr_out="#TIMEOUT"
		return
	fi

	[[ rkr_debug -eq 1 ]] && printf "reply:%02x " "'$REPLY"		# Debugging

	case "${REPLY}" in
		$'\x08'|$'\x7f') rkr_tmp="#BS" ;;
		$'\n') rkr_tmp="#LF" ;;
		$'\t') rkr_tmp="#TAB" ;;

		$'\e') # ESC or ESC-sequence?
			if read -r -n1 -t 0.02 rkr_next; then
				[[ rkr_debug -eq 1 ]] && printf "next1:%02x " "'$rkr_next"
				rkr_tmp="$rkr_next"
				while read -r -n1 -t 0.02 rkr_next; do
					[[ rkr_debug -eq 1 ]] && printf "next2:%02x " "'$rkr_next"
					if [[ "$rkr_next" = $'\e' ]]; then
						# Another ESC sequence started — drain and discard it
						while read -r -n1 -t 0.01 rkr_next; do :; done
						break
					fi
					rkr_tmp+="$rkr_next"
				done
				[[ rkr_debug -eq 1 ]] && printf "rkr_tmp:$rkr_tmp "
				xlate_esc rkr_tmp
			else
				rkr_tmp="#ESC"
			fi
			;;

		*) # Check for UTF-8 and CTRL keys
			# UTF-8 multi-byte sequence?
			printf -v rkr_first "%d" "'$REPLY"
			if (( rkr_first >= 0xC2 && rkr_first <= 0xF4 )); then
				rkr_tmp="$REPLY"
				# Determine expected length
				if (( rkr_first <= 0xDF )); then rkr_expected=1
				elif (( rkr_first <= 0xEF )); then rkr_expected=2
				else rkr_expected=3
				fi
				for ((rkr_i=0; rkr_i<rkr_expected; rkr_i++)); do
					if read -r -n1 -t 0.01 rkr_next; then
						rkr_tmp+="$rkr_next"
					fi
				done
				rkr_out="$rkr_tmp"
				return
			fi

			# Control key?
			printf -v rkr_ctrl "%d" "'$REPLY"
			if [[ $rkr_ctrl -gt 0 && $rkr_ctrl -le 26 ]]; then
				printf -v rkr_tmp '%03o' "$((rkr_ctrl + 64))"
				printf -v rkr_tmp "#C-%b" "\\$rkr_tmp"
			else
				rkr_tmp="$REPLY"
			fi
			;;
	esac
	rkr_out="${rkr_tmp}"
}

#======================================================================
# Function: xlate_esc
#	Translate escape sequences to readable key names
#	Do not call this function directly; it is called by read_key_raw.
#======================================================================
function xlate_esc()
{
	local -n rkr_val=$1

	[[ rkr_debug -eq 1 ]] && printf "xlate:$rkr_val "
	case "$rkr_val" in
		# Function keys
		"OP")     rkr_val="#f1" ;;		"OQ")     rkr_val="#f2" ;;		"OR")     rkr_val="#f3" ;;
		"OS")     rkr_val="#f4" ;;		"[15~")   rkr_val="#f5" ;;		"[17~")   rkr_val="#f6" ;;
		"[18~")   rkr_val="#f7" ;;		"[19~")   rkr_val="#f8" ;;		"[20~")   rkr_val="#f9" ;;
		"[21~")   rkr_val="#f10" ;;		"[23~")   rkr_val="#f11" ;;		"[24~")   rkr_val="#f12" ;;
		# Shifted function keys
		"[1;2P")  rkr_val="#F1" ;;		"[1;2Q")  rkr_val="#F2" ;;		"[1;2R")  rkr_val="#F3" ;;
		"[1;2S")  rkr_val="#F4" ;;		"[15;2~") rkr_val="#F5" ;;		"[17;2~") rkr_val="#F6" ;;
		"[18;2~") rkr_val="#F7" ;;		"[19;2~") rkr_val="#F8" ;;		"[20;2~") rkr_val="#F9" ;;
		"[21;2~") rkr_val="#F10" ;;		"[23;2~") rkr_val="#F11" ;;		"[24;2~") rkr_val="#F12" ;;
		# Control function keys
		"[1;5P")  rkr_val="#C-f1" ;;	"[1;5Q")  rkr_val="#C-f2"  ;;	"[1;5R")  rkr_val="#C-f3" ;;
		"[1;5S")  rkr_val="#C-f4" ;;	"[15;5~") rkr_val="#C-f5" ;;	"[17;5~") rkr_val="#C-f6" ;;
		"[18;5~") rkr_val="#C-f7" ;;	"[19;5~") rkr_val="#C-f8" ;;	"[20;5~") rkr_val="#C-f9" ;;
		"[21;5~") rkr_val="#C-f10" ;;	"[23;5~") rkr_val="#C-f11" ;;	"[24;5~") rkr_val="#C-f12" ;;
		# Control+Shift function keys
		"[1;6P")  rkr_val="#C-F1" ;;	"[1;6Q")  rkr_val="#C-F2"  ;;	"[1;6R")  rkr_val="#C-F3" ;;
		"[1;6S")  rkr_val="#C-F4" ;;	"[15;6~") rkr_val="#C-F5" ;;	"[17;6~") rkr_val="#C-F6" ;;
		"[18;6~") rkr_val="#C-F7" ;;	"[19;6~") rkr_val="#C-F8" ;;	"[20;6~") rkr_val="#C-F9" ;;
		"[21;6~") rkr_val="#C-F10" ;;	"[23;6~") rkr_val="#C-F11" ;;	"[24;6~") rkr_val="#C-F12" ;;
		# Alt function keys
		"[1;3P")  rkr_val="#A-f1" ;;	"[1;3Q")  rkr_val="#A-f2"  ;;	"[1;3R")  rkr_val="#A-f3" ;;
		"[1;3S")  rkr_val="#A-f4" ;;	"[15;3~") rkr_val="#A-f5" ;;	"[17;3~") rkr_val="#A-f6" ;;
		"[18;3~") rkr_val="#A-f7" ;;	"[19;3~") rkr_val="#A-f8" ;;	"[20;3~") rkr_val="#A-f9" ;;
		"[21;3~") rkr_val="#A-f10" ;;	"[23;3~") rkr_val="#A-f11" ;;	"[24;3~") rkr_val="#A-f12" ;;
		# Alt+Shift function keys
		"[1;4P")  rkr_val="#A-F1" ;;	"[1;4Q")  rkr_val="#A-F2"  ;;	"[1;4R")  rkr_val="#A-F3" ;;
		"[1;4S")  rkr_val="#A-F4" ;;	"[15;4~") rkr_val="#A-F5" ;;	"[17;4~") rkr_val="#A-F6" ;;
		"[18;4~") rkr_val="#A-F7" ;;	"[19;4~") rkr_val="#A-F8" ;;	"[20;4~") rkr_val="#A-F9" ;;
		"[21;4~") rkr_val="#A-F10" ;;	"[23;4~") rkr_val="#A-F11" ;;	"[24;4~") rkr_val="#A-F12" ;;
		# Alt+Control function keys
		"[1;7P")  rkr_val="#AC-f1" ;;	"[1;7Q")  rkr_val="#AC-f2"  ;;	"[1;7R")  rkr_val="#AC-f3" ;;
		"[1;7S")  rkr_val="#AC-f4" ;;	"[15;7~") rkr_val="#AC-f5" ;;	"[17;7~") rkr_val="#AC-f6" ;;
		"[18;7~") rkr_val="#AC-f7" ;;	"[19;7~") rkr_val="#AC-f8" ;;	"[20;7~") rkr_val="#AC-f9" ;;
		"[21;7~") rkr_val="#AC-f10" ;;	"[23;7~") rkr_val="#AC-f11" ;;	"[24;7~") rkr_val="#AC-f12" ;;
		# Alt+Control+Shift function keys
		"[1;8P")  rkr_val="#AC-F1" ;;	"[1;8Q")  rkr_val="#AC-F2"  ;;	"[1;8R")  rkr_val="#AC-F3" ;;
		"[1;8S")  rkr_val="#AC-F4" ;;	"[15;8~") rkr_val="#AC-F5" ;;	"[17;8~") rkr_val="#AC-F6" ;;
		"[18;8~") rkr_val="#AC-F7" ;;	"[19;8~") rkr_val="#AC-F8" ;;	"[20;8~") rkr_val="#AC-F9" ;;
		"[21;8~") rkr_val="#AC-F10" ;;	"[23;8~") rkr_val="#AC-F11" ;;	"[24;8~") rkr_val="#AC-F12" ;;
		# Cursor keys
		"[A")     rkr_val="#UP" ;;		"[B")     rkr_val="#DN" ;;		"[C")     rkr_val="#RT" ;;
		"[D")     rkr_val="#LT" ;;		"[H")     rkr_val="#HOM" ;;		"[F")     rkr_val="#END" ;;
		"[2~")    rkr_val="#INS" ;;		"[3~")    rkr_val="#DEL" ;;		"[5~")    rkr_val="#PUP" ;;
		"[6~")    rkr_val="#PDN" ;;
		# macOS differences
		"OH")    rkr_val="#HOM" ;;		"OF")    rkr_val="#END" ;;
		# Alt cursor keys
		"[1;3A")  rkr_val="#A-UP" ;;	"[1;3B")  rkr_val="#A-DN" ;;	"[1;3C")  rkr_val="#A-RT" ;;
		"[1;3D")  rkr_val="#A-LT" ;;	"[1;3H")  rkr_val="#A-HOM" ;;	"[1;3F")  rkr_val="#A-END" ;;
		"[2;3~")  rkr_val="#A-INS" ;;	"[3;3~")  rkr_val="#A-DEL" ;;	"[5;3~")  rkr_val="#A-PUP" ;;
		"[6;3~")  rkr_val="#A-PDN" ;;
		# Control cursor keys
		"[1;5A")  rkr_val="#C-UP" ;;	"[1;5B")  rkr_val="#C-DN" ;;	"[1;5C")  rkr_val="#C-RT" ;;
		"[1;5D")  rkr_val="#C-LT" ;;	"[1;5H")  rkr_val="#C-HOM" ;;	"[1;5F")  rkr_val="#C-END" ;;
		"[2;5~")  rkr_val="#C-INS" ;;	"[3;5~")  rkr_val="#C-DEL" ;;	"[5;5~")  rkr_val="#C-PUP" ;;
		"[6;5~")  rkr_val="#C-PDN" ;;
		# Alt+<key> sequences
		[!-~])    rkr_val="#A-$rkr_val" ;;
	esac
	[[ rkr_debug -eq 1 ]] && printf "xlate:$rkr_val "
}

# Global variable to hold baseline - Don't touch!
READ_KEY_RAW_BASELINE_STTY=""
# Set to 1 to enable debugging output
rkr_debug=0
