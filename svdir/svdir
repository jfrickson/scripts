# shellcheck shell=bash

#======================================================================
# Initialize common variables
#======================================================================

version="1.0.1"
verbose=1
_d=$'\e[1m'				# Print bold
_r=$'\e[1;31m'			# Print bold red
_y=$'\e[1;33m'			# Print bold yellow
_c=$'\e[1;36m'			# Print bold cyan
_g=$'\e[1;32m'			# Print bold green
_rst=$'\e[0m'			# Reset to normal color

declare -i numdirs=0
base="${HOME}/.config/svdir"	# Directory for bookmark files
[[ -n "${SVDIR_CFG}" ]] && base="${SVDIR_CFG}"

#======================================================================
# Functions
#======================================================================


function version()
{
	printf "\n%sSVDir - Version %s%s\n\n" "${_g}" "${version}" "${_rst}"
}

#----------------------------------------------------------------------
# Function:		short_usage
# Description:	Print a short usage message for the given command
#----------------------------------------------------------------------
function short_usage()
{
	local descr dir_lit="dirs" args=

	case $1 in
		sc|sv)
			dir_lit="dir"
			descr="Save current directory"
			args="name"
			;;
		ls) descr="List saved directories"
			;;
		rm)
			descr="Remove currently saved directories"
			args="name"
			;;
		sb)
			descr="Save current directories as bookmark"
			args="name"
			;;
		lb)
			descr="List bookmarks"
			args="name"
			;;
		ld)
			descr="Load bookmarks"
			args="name"
			;;
		db)
			descr="Delete bookmarks"
			args="name"
			;;
	esac

	echo
	echo "${_c}${descr}${_rst}"
	echo -n "${_y}Usage:${_rst} ${_d}${1}${dir_lit} [-V|-h|-H"
	[[ -n "${args}" ]] && echo "|${args}]" || echo "]"
	printf "    %s-V%s     Show version information\n" "${_d}" "${_rst}"
	printf "    %s-h%s     Show this short usage\n" "${_d}" "${_rst}"
	printf "    %s-H%s     Show the long usage\n" "${_d}" "${_rst}"

	case $1 in
		sc)
			printf "    %sname%s   Save with optional name\n" "${_d}" "${_rst}"
			;;
		rm)
			printf "    %sname%s   If 'name' specified, remove only the given name\n" "${_d}" "${_rst}"
			;;
		sb|ld|db)
			printf "    %sname%s   ${descr} named 'name'\n" "${_d}" "${_rst}"
			;;
		lb)
			printf "    %sname%s   If 'name' specified, list directories in that bookmark\n" "${_d}" "${_rst}"
			;;
	esac

	printf "\nOther help commands:\n"
	printf "    %ssvdir -h%s     Save current directory\n" "${_d}" "${_rst}"
	printf "    %sscdir -h%s     Save current directory (alias)\n" "${_d}" "${_rst}"
	printf "    %slsdirs -h%s    List saved directories\n" "${_d}" "${_rst}"
	printf "    %srmdirs -h%s    Remove saved directories\n" "${_d}" "${_rst}"
	printf "    %ssbdirs -h%s	 Save current directories as bookmark\n" "${_d}" "${_rst}"
	printf "    %slbdirs -h%s    List bookmarks\n" "${_d}" "${_rst}"
	printf "    %slddirs -h%s    Load bookmarks\n" "${_d}" "${_rst}"
	printf "    %sdbdirs -h%s    Delete bookmarks\n\n" "${_d}" "${_rst}"

	printf "For full usage, enter: %ssvdir -H%s\n\n" "${_d}" "${_rst}"
}

#----------------------------------------------------------------------
# Function:		long_usage
# Description:	Print a long usage message for the script
#----------------------------------------------------------------------
function long_usage()
{
	cat <<- EOF
		    Normally, this file (svdir) is sourced from an alias, though it can
		    be sourced from the command line.

		    ${_y}Usage:${_rst}
		        ${_d}source svdir % [-h|-H|-V|sc [name]|ls|rm [name]|sb name|lb name|ld [name]]${_rst}

		    The '%' is used to know if this help text should be printed. If the '%'
		    is not there, this prints. This help text can be also be printed by using
		    the command ${_y}svdir -H${_rst}.

		    ${_c}Save Current Directory (sc)${_rst}
		    If called as 'source svdir % sc', it will save the current directory as an
		    alias.

		    It can be called with 'name' to specify the name of the alias. This
		    is handy if multiple directories with the same name but different paths
		    is saved, or if the directory name is long and a shorter one is needed.
		    For example:
		        ${_y}\$${_rst} ${_d}cd ~/bin${_rst}
		        ${_y}\$${_rst} ${_d}scdir .homebin${_rst}
		        alias .homebin='cd /home/klaatu/bin'
		        ${_y}\$${_rst} ${_d}cd /usr/bin${_rst}
		        ${_y}\$${_rst} ${_d}scdir .usrbin${_rst}
		        alias .usrbin='cd /usr/bin'
		    Or
		        ${_y}\$${_rst} ${_d}cd ~/this-directory-has-my-pictures${_rst}
		        ${_y}\$${_rst} ${_d}scdir .pics${_rst}
		        alias .pics='cd /home/klaatu/this-directory-has-my-pictures'

		    ${_c}List Saved Directories (ls)${_rst}
		        Preferred: ${_y}\$${_rst} ${_d}lsdirs${_rst}
		        Optional:  ${_y}\$${_rst} ${_d}source svdir % ls${_rst}

		    ${_c}Remove Saved Directories (rm)${_rst}
		    If given without arguments, this will remove all current saved directory
		    aliases. With an argument, it will remove the given saved directory alias.
		        Preferred: ${_y}\$${_rst} ${_d}rmsvdir .homebin${_rst}           # Removes .homebin
		                   ${_y}\$${_rst} ${_d}rmsvdir${_rst}                    # Removes all
		        Optional:  ${_y}\$${_rst} ${_d}source svdir % rm .homebin${_rst} # Removes .homebin
		                   ${_y}\$${_rst} ${_d}source svdir % rm${_rst}          # Removes all

		    ${_c}Save Current Directories as a Bookmark File (sb)${_rst}
		    Bookmark files can be created for often used sets of saved directories.
		    For 'project 1', you can have saved directories of the base development
		    directory, the project directory, the source directory, and a bin
		    directory. This set of saved directories can be saved like this:
		        ${_y}\$${_rst} ${_d}sbdirs proj1${_rst}
		    After which, you can load those saved directories using the ${_y}ld${_rst} command
		    described later. Bookmark files are stored in ${_d}\$HOME/.config/svdir/${_rst}.

		    ${_c}List Bookmarks (lb)${_rst}
		    A list of all bookmark files is obtained using the following:
		        ${_y}\$${_rst} ${_d}lbdirs${_rst}
		    List the saved directories in a bookmark file:
		        ${_y}\$${_rst} ${_d}lbdirs proj1${_rst}

		    ${_c}Load Saved Directories From a Bookmark File (ld)${_rst}
		    Load a set of saved directories from a bookmark file:
		        ${_y}\$${_rst} ${_d}lddirs proj1${_rst}

		    ${_c}Delete a Bookmark File (db)${_rst}
		    Delete a bookmark file:
		        ${_y}\$${_rst} ${_d}dbdirs proj1${_rst}

		    ${_c}List of aliases${_rst}
		    To make this easy to use, you should have the following aliases defined
		    in a ~/.alias or ~/.bashrc file.
		        ${_y}alias${_rst} ${_c}svdir${_rst}='${_d}. ~/bin/svdir % sc${_rst}'     # Save current dir
		        ${_y}alias${_rst} ${_c}scdir${_rst}='${_d}. ~/bin/svdir % sc${_rst}'     # Save current dir (alias)
		        ${_y}alias${_rst} ${_c}lsdirs${_rst}='${_d}. ~/bin/svdir % ls${_rst}'    # List saved dirs
		        ${_y}alias${_rst} ${_c}rmdirs${_rst}='${_d}. ~/bin/svdir % rm${_rst}'    # Remove saved dirs
		        ${_y}alias${_rst} ${_c}sbdirs${_rst}='${_d}. ~/bin/svdir % sb${_rst}'    # Save as bookmark
		        ${_y}alias${_rst} ${_c}lbdirs${_rst}='${_d}. ~/bin/svdir % lb${_rst}'    # List bookmarks
		        ${_y}alias${_rst} ${_c}lddirs${_rst}='${_d}. ~/bin/svdir % ld${_rst}'    # Load bookmarks
		        ${_y}alias${_rst} ${_c}dbdirs${_rst}='${_d}. ~/bin/svdir % db${_rst}'    # Delete bookmarks
		        ${_y}alias${_rst} ${_c}svdir-aliases${_rst}='${_d}alias | grep svdir | grep -v svdir-aliases${_rst}'

		    ${_c}Get Usage${_rst}
		    Enter '${_y}svdir -h${_rst}' or '${_y}source svdir % -h${_rst}' to get the short usage document.

	EOF

	return
}

#----------------------------------------------------------------------
# Function:		check_aliases
# Description:	Check if the expected aliases are defined, and
#				offer to add them if not
#----------------------------------------------------------------------
function check_aliases()
{
	local -a als
	local -A aliases
	local entry append_file="${HOME}/.bashrc" script="${BASH_SOURCE[0]}"

	mapfile -t als < <(alias | grep -E "/svdir %")
	for entry in "${als[@]}"; do
		if [[ $entry =~ "alias scdir" ]]; then		aliases[sc]="Found"
		elif [[ $entry =~ "alias svdir" ]]; then	aliases[sv]="Found"
		elif [[ $entry =~ "alias lsdirs" ]]; then	aliases[ls]="Found"
		elif [[ $entry =~ "alias rmdirs" ]]; then	aliases[rm]="Found"
		elif [[ $entry =~ "alias sbdirs" ]]; then	aliases[sb]="Found"
		elif [[ $entry =~ "alias lbdirs" ]]; then	aliases[lb]="Found"
		elif [[ $entry =~ "alias lddirs" ]]; then	aliases[ld]="Found"
		elif [[ $entry =~ "alias dbdirs" ]]; then	aliases[db]="Found"
		fi
	done

	if [[ ${#aliases[@]} -eq 8 ]]; then return; fi

	put "W" "Some or all svdir aliases are missing:\n"
	for key in sc sv ls rm sb lb ld db; do
		if [[ -z "${aliases[$key]}" ]]; then
			aliases[$key]="Missing"
			printf "      ${key}   ${_y}Missing${_rst}\n"
		else
			printf "      ${key}   Found\n"
		fi
	done

	put "h" "    Do you want this script to add them? [Y|n] "
	read -n1 -r -s
	printf "\n\n"

	[[ -z "${REPLY}" ]] && REPLY="Y"
	[[ "${REPLY}" =~ [yY] ]] || return

	if [[ -f "${HOME}/.alias" ]]; then
		append_file="${HOME}/.alias"
	fi

	for key in sc sv ls rm sb lb ld db; do
		entry="${key}dirs"
		[[ $key == "sc" || $key == "sv" ]] && entry="${key}dir"

		if [[ "${aliases[$key]}" == "Missing" ]]; then
			alias ${entry}=". ${script} % ${key}"
			echo "alias ${entry}='. ${script} % ${key}'" >> "${append_file}"
			printf "      Added alias for ${key}\n"
		fi
	done
	printf "\n    %sThe new aliases are now active.%s\n\n" "${_g}" "${_rst}"
	return
}


#----------------------------------------------------------------------
# Function:		save_current
# Description:	Save the current directory as an alias
#----------------------------------------------------------------------
function save_current()
{
	local _cwd _dir

	_cwd=$(pwd)

	if [[ -n "$1" ]]; then
		if [[ ! $1 =~ ^\. ]]; then
			put "W" "Name must start with a '.'\n    Did you mean '.$1'?\n"
			return
		fi
		# Validate that the name contains only safe characters
		if [[ ! $1 =~ ^\.[-_[:alnum:]]+$ ]]; then
			put "W" "Name must contain only alphanumeric characters, hyphens, and underscores\n"
			return
		fi
		_dir="$1"
	else
		_dir=".$(basename "${_cwd}")"
	fi

	# shellcheck disable=SC2139
	alias "${_dir}"="cd ${_cwd}"
	put "p" "alias ${_dir}='cd ${_cwd}'"
}

#----------------------------------------------------------------------
# Function:		list_saved
# Description:	List currently saved directory aliases
#----------------------------------------------------------------------
function list_saved()
{
	local als trg entry

	put "h" "Saved directories\n"
	get_saved
	if [[ "${numdirs}" -eq 0 ]]; then
		put "w" "No saved directories\n\n"
		return
	fi

	for entry in "${list[@]}"; do
		als=$(echo "${entry}" | cut -d'=' -f1)
		trg=$(echo "${entry}" | cut -d'=' -f2- | cut -d' ' -f2-)
		printf -v als "    %-10s" "${als}"
		put "b" "${als}"
		printf " %s\n" "${trg}"
	done
	put "p" ""
}

#----------------------------------------------------------------------
# Function:		del_saved
# Description:	Delete saved directory aliases
#----------------------------------------------------------------------
function del_saved()
{
	local als entry

	if [[ -n "$1" ]]; then
		als="$1"
		put "h" "Removing '${als}'\n"
		if ! unalias "${als}" 2>/dev/null; then
			put "w" "'${als}' is not a saved directory\n"
		fi
	else
		put "h" "Removing saved directories\n"
		get_saved
		if [[ "${numdirs}" -eq 0 ]]; then
			put "w" "No saved directories\n\n"
		fi
		for entry in "${list[@]}"; do
			als=$(echo "${entry}" | cut -d'=' -f1)
			put "p" "    Removing ${als}"
			unalias "${als}" 2>/dev/null
		done
	fi
	put "p" ""
}

#----------------------------------------------------------------------
# Function:		save_bkmarks
# Description:	Save current aliases as a bookmark file
#----------------------------------------------------------------------
function save_bkmarks()
{
	local bkmark="$1"
	local fname entry als trg

	if [[ -z "$1" ]]; then
		put "W" "No bookmark name specified\n"
		return
	fi

	get_saved
	if [[ "${numdirs}" -eq 0 ]]; then
		put "W" "    No saved directories\n\n"
		return
	fi

	[[ -d "${base}" ]] || mkdir -p "${base}"
	fname="${base}/${bkmark}.sv"
	if [[ -f "${fname}" ]]; then
		read -n1 -r -p "Replace ${bkmark}? [Y|n] "
		[[ "${REPLY}" =~ [nN] ]] && { echo; echo; return; }
		[[ -n "${REPLY}" ]] && echo
	fi

	: > "${fname}"  # truncate

	for entry in "${list[@]}"; do
		als=$(echo "${entry}" | cut -d'=' -f1)
		trg=$(echo "${entry}" | cut -d'=' -f2- | cut -d' ' -f2-)
        # Escape single quotes for shell alias definition
        esc_trg=${trg//\'/\'\"\'\"\'}
        put "p" "alias ${als}='cd ${esc_trg}'" >> "${fname}"
	done
	put "b" "\nDirectories saved as '${bkmark}'\n\n"
}

#----------------------------------------------------------------------
# Function:		list_bkmarks
# Description:	List bookmark files or aliases in a bookmark file
#----------------------------------------------------------------------
function list_bkmarks()
{
	local bkmark="$1"
	local numfiles fname
	[[ -d "${base}" ]] || mkdir -p "${base}"

	if [[ -z "${bkmark}" ]]; then
		put "h" "Saved bookmark files\n"
		readarray -t list < <(ls -1 "${base}"/*.sv 2>/dev/null)
		numfiles=${#list[*]}
		if [[ "${numfiles}" -eq 0 ]]; then
			put "w" "No saved bookmark files\n\n"
			return
		fi

		for entry in "${list[@]}"; do
#			entry=${entry%.sv}
			entry=$(basename -s.sv "${entry}")
			put "b" "   ${entry}\n"
		done
		echo
		return
	fi

	fname="${base}/${bkmark}.sv"
	put "h" "Bookmark file '${bkmark}'\n"
	if [[ ! -f "${fname}" ]]; then
		put "W" "'${bkmark}' does not exist\n"
		return
	fi

	cat "${fname}"
	echo
}

#----------------------------------------------------------------------
# Function:		load_bkmrks
# Description:	Load aliases from a bookmark file
#----------------------------------------------------------------------
function load_bkmrks()
{
	local bkmark="$1"
	local fname="${base}/${bkmark}.sv"

	if [[ -z "$1" ]]; then
		put "W" "No bookmark file name specified\n"
		return
	fi

	check_file "${bkmark}" || return

	# shellcheck source=../.config/svdir/vff.sv
	source "${fname}"
	put "b" "\n'${bkmark}' loaded\n\n"
}

#----------------------------------------------------------------------
# Function:		del_bkmarks
# Description:	Delete a bookmark file
#----------------------------------------------------------------------
function del_bkmarks()
{
	local bkmark="$1"
	local fname="${base}/${bkmark}.sv"

	if [[ -z "$1" ]]; then
		put "W" "No bookmark file name specified\n"
		return
	fi

	if [[ ! -f "${fname}" ]]; then
		put "W" "'${bkmark}' does not exist\n"
		return
	fi

	rm -f "${fname}"
	put "b" "\n'${bkmark}' deleted\n\n"
}

#----------------------------------------------------------------------
# Function:		put
# Description:	Write text with colors
#----------------------------------------------------------------------
function put()
{
	[[ $verbose -eq 0 ]] && return

	local typ=$1
	local msg="$2"

	case ${typ} in
		b)	printf "%s" "${_d}" ;;				# Bold
		W)	printf "    %s" "${_y}svdir: " ;;	# Warning
		w)	printf "    %s" "${_y} " ;;			# Warning
		e)	printf "    %s" "${_r} " ;;			# Error
		h)	printf "\n%s" "${_c}" ;;			# Bold cyan
		p)	printf "%s\n" "${msg}"; return;;	# Plain
	esac

	printf "%b%s" "${msg}" "${_rst}"
}

#----------------------------------------------------------------------
# Function:		get_saved
# Description:	Get a list of currently saved directories
#----------------------------------------------------------------------
function get_saved()
{
	readarray -t list < <(alias | grep -E "^alias \.+.+='cd " | \
		grep -E -v " ..=| ...=" | sed -e 's/^alias //' -e "s/'//g")
    numdirs=${#list[*]}
}

#----------------------------------------------------------------------
# Function:		check_file
# Description:	Check if a bookmark file is valid
#----------------------------------------------------------------------
function check_file()
{
	local fn="$1" fname fspec line
	local -i sz ln=0

	fname="${fn}.sv"
	fspec="${base}/${fname}"

	if [[ ! -f "${fspec}" ]]; then
		put "e" "${fn} was not found\n"
		return 2
	fi
	sz=$(stat -c %s "${fspec}")
	if [[ "${sz}" -gt 10240 ]]; then
		put "e" "${fn} is too large (${sz})\n"
		return 27
	fi

	while IFS= read -r line; do
		: $((++ln))
		# Match: alias .name='cd /path' (with or without spaces around =)
        if ! [[ "${line}" =~ ^alias\ +\.[^=\ ]+\ *=\ *\'cd\ /.+\'$ ]]; then
			put "e" "File ${fname} line ${ln} is invalid: \"${line}\"\n"
		    return 1
		fi
	done < "${fspec}"
	return 0
}

#======================================================================
# Main processing
#======================================================================
function main()
{
	[[ "${1:-}" == "-V" ]] && { version; return; }
	[[ "${1:-}" == "-h" ]] && { short_usage "$1"; return; }
	if [[ "$1" == "%" ]]; then shift; else short_usage; return; fi

	[[ "${2:-}" == "-H" ]] && { long_usage; return; }
	[[ "${2:-}" == "-h" ]] && { short_usage "$1"; return; }
	[[ "${2:-}" == "-V" ]] && { version; return; }
	[[ "${2:-}" == "-q" ]] && { set -- "$1" "${@:3}"; verbose=0; }

	case $1 in
		sc) save_current "${2}" ;;
		ls) list_saved ;;
		rm) del_saved "${2}" ;;
		sb) save_bkmarks "${2}" ;;
		lb) list_bkmarks "${2}" ;;
		ld) load_bkmrks "${2}" ;;
		db) del_bkmarks "${2}" ;;
		-h) short_usage "$1" "${2}" ;;
		-H) long_usage ;;
		*)  put "e" "Invalid option: $1\n\n"
	esac
}

check_aliases
main "$@"
